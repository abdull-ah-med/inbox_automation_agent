# Copy to backend/.env for local dev, or backend/.env.prod for production
# (both are gitignored). Fill in real values — do not commit secrets.
#
# Outside ENVIRONMENT=local, Settings.validate_production_security() refuses
# to start the app unless: REDIS_URL is rediss:// with a password,
# REDIS_SSL_CA_CERTS is set, DATABASE_URL is non-localhost, API_HOST is the
# public hostname (not localhost), FRONTEND_ORIGIN is https://, JWT_SECRET is
# >=64 chars, COOKIE_SECURE=true, ENABLE_DEV_ROUTES=false, and Graph/Slack/MSAL
# keys below are set. See README.md "Production (EC2)" for the full deploy runbook.

# --- Environment ---
# local | staging | production. Defaults to "production" (fail-closed) if unset.
ENVIRONMENT=local

# --- Anthropic (triage + draft generation — required for the core pipeline) ---
ANTHROPIC_API_KEY=
CLASSIFICATION_MODEL=claude-haiku-4-5
DRAFT_MODEL=claude-sonnet-4-6
TRIAGE_MAX_TOKENS=200

# --- OpenAI (embeddings: cross-thread context + reply-tone memory) ---
# Optional — missing key just disables embeddings/tone-matching (logged, no crash).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MIN_SIMILARITY=0.78
# Hybrid retrieval: over-fetch per leg, then collapse to best conversation(s).
EMBEDDING_CANDIDATE_K=50
EMBEDDING_FINAL_CONVERSATIONS=1
EMBEDDING_MAX_INPUT_TOKENS=8000
RRF_K=60
# pgvector HNSW query-time knobs (no rebuild). Production sweet spot: 80–200.
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN_ENABLED=true
# InboxAssistant RAG hardening. Groundedness starts off; enable after golden evals pass.
CHAT_GROUNDEDNESS_ENABLED=false
CHAT_SEMANTIC_CACHE_ENABLED=true
CHAT_SEMANTIC_CACHE_THRESHOLD=0.92
CHAT_SEMANTIC_CACHE_TTL_OVERVIEW_SEC=300
CHAT_SEMANTIC_CACHE_TTL_SEARCH_SEC=1200
CHAT_MAX_INPUT_TOKENS=160000
CHAT_RATE_LIMIT_PER_MINUTE=60
# Same-thread prompt packing (verbatim recent messages; older use summaries).
THREAD_VERBATIM_TAIL=2
THREAD_FULL_IF_AT_MOST=5

# --- Microsoft Graph (Mail.Read only — this app never sends/moves/deletes mail) ---
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
# Any random string >=32 chars; validated against inbound webhook payloads.
GRAPH_WEBHOOK_CLIENT_STATE=
# Optional public HTTPS endpoints for Graph change notifications.
# Leave GRAPH_WEBHOOKS_ENABLED=false (default) for poll-only mode: the interval
# poller (POLL_ENABLED / POLL_INTERVAL_SECONDS) is the primary source for Inbox,
# Junk, and Sent Items. Set GRAPH_WEBHOOKS_ENABLED=true only when these URLs are
# reachable by Microsoft Graph.
GRAPH_WEBHOOKS_ENABLED=false
GRAPH_NOTIFICATION_URL=
GRAPH_LIFECYCLE_URL=
# Comma-separated mailbox addresses this app is allowed to touch.
TARGET_MAILBOXES=
# Optional. Personal/user mailboxes whose Sent Items may close a shared-inbox
# thread (e.g. Elise replies from elise@ while the mail landed in inquiries@).
# Polled Mail.Read, Sent Items only. Must be in the Entra app access policy.
REVIEWER_MAILBOXES=
# Optional. Personal inbox owners: CSV of email:DisplayName.
# Mail landing in an owned mailbox is for that person; drafts sign as that name.
# Example: sampleagent@sample-site.example.com:Elise
MAILBOX_OWNERS=
STALENESS_THRESHOLD_HOURS=24
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=300
POLL_CONCURRENCY=3
# Recurring healer for stuck NEW + open outbound tips. Default off. Mail.Read only.
HEAL_THREADS_ENABLED=false
HEAL_THREADS_INTERVAL_MINUTES=60
HEAL_THREADS_MAX_PER_RUN=50
SUBSCRIPTION_RENEW_INTERVAL_HOURS=48
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MSAL_CACHE_ENCRYPTION_KEY=

# --- Slack (draft review notifications; optional) ---
# Web dashboard works without Slack. Set true only when review cards are wanted.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_REVIEW_CHANNEL_ID=

# --- Database ---
# In docker-compose.prod.yml this file is the ONLY source of DATABASE_URL —
# use the `postgres` Compose service name as host, with the POSTGRES_PASSWORD
# you set in the repo-root .env, e.g.:
#   postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@postgres:5432/inbox_triage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inbox_triage
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis ---
# Outside local: must be rediss:// (TLS) with a password. In
# docker-compose.prod.yml this file is the ONLY source of REDIS_URL — use the
# `redis` Compose service name as host, with the REDIS_PASSWORD you set in
# the repo-root .env (see deploy/gen-redis-tls.sh), e.g.:
#   REDIS_URL=rediss://:<REDIS_PASSWORD>@redis:6379/0
#   REDIS_SSL_CA_CERTS=/tls/ca.crt
# Do NOT set ssl_cert_reqs=none — production requires server cert verification
# via REDIS_SSL_CA_CERTS (redis-py ssl_ca_certs / ssl_cert_reqs=required).
# https://redis.readthedocs.io/en/latest/connections.html
REDIS_URL=redis://localhost:6379/0
REDIS_SSL_CA_CERTS=
REDIS_MAX_CONNECTIONS=50

# --- Web auth (JWT access + rotating refresh cookie) ---
# Generate with: openssl rand -hex 32   (must be >=64 chars outside local)
JWT_SECRET=
JWT_ISSUER=inbox-triage-automation
JWT_AUDIENCE=inbox-triage-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=itr_refresh
CSRF_COOKIE_NAME=itr_csrf
CSRF_HEADER_NAME=X-CSRF-Token
REFRESH_ROTATION_GRACE_SECONDS=10

# --- Cookies / CORS ---
# Must be https:// outside local.
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
# Must be true outside local.
COOKIE_SECURE=false
# Public Host header for TrustedHostMiddleware. Outside local this MUST be the
# hostname nginx forwards (e.g. 3-91-x-x.sslip.io) — not localhost.
# https://fastapi.tiangolo.com/advanced/middleware/#trustedhostmiddleware
API_HOST=localhost

# --- Reverse proxy ---
# Required true outside local (startup refuses otherwise). Set true when nginx
# (or another reverse proxy) sits in front and sets X-Real-IP=$remote_addr
# (see deploy/nginx.conf.template). Rate limiting then keys on X-Real-IP.
# Local default stays false (no proxy).
TRUST_X_FORWARDED_FOR=false

# --- Rate limits ---
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_REFRESH_RATE_LIMIT=30/minute
API_DEFAULT_RATE_LIMIT=120/minute

# --- Webhooks ---
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# --- Dev-only routes (/simulate, /debug) ---
# Must be false outside local.
ENABLE_DEV_ROUTES=false
DEV_API_KEY=

# --- Weekly ops report (PDF download + Monday job; never Graph send) ---
# Empty OPS_REPORT_DIR = generate on demand only (download still works).
OPS_REPORT_DIR=
OPS_REPORT_TIMEZONE=America/New_York
OPS_REPORT_CRON_DAY_OF_WEEK=mon
OPS_REPORT_CRON_HOUR=8
OPS_REPORT_CRON_MINUTE=0
# Optional SMTP delivery. Default off. Do not use Microsoft Graph sendMail.
OPS_REPORT_EMAIL_ENABLED=false
OPS_REPORT_SMTP_HOST=
OPS_REPORT_SMTP_PORT=587
OPS_REPORT_SMTP_USER=
OPS_REPORT_SMTP_PASSWORD=
OPS_REPORT_SMTP_FROM=
OPS_REPORT_SMTP_TO=

SALUTE_DIRECTORY_ENABLED=false
