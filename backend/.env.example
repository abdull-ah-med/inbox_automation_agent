# Copy to backend/.env for local dev, or backend/.env.prod for production
# (both are gitignored). Fill in real values — do not commit secrets.
#
# Outside ENVIRONMENT=local, Settings.validate_production_security() refuses
# to start the app unless: REDIS_URL is rediss:// with a password, DATABASE_URL
# is non-localhost, FRONTEND_ORIGIN is https://, JWT_SECRET is >=64 chars,
# COOKIE_SECURE=true, ENABLE_DEV_ROUTES=false, and Graph/Slack/MSAL keys below
# are set. See README.md "Production (EC2)" for the full deploy runbook.

# --- Environment ---
# local | staging | production. Defaults to "production" (fail-closed) if unset.
ENVIRONMENT=local

# --- Anthropic (triage + draft generation — required for the core pipeline) ---
ANTHROPIC_API_KEY=
CLASSIFICATION_MODEL=claude-haiku-4-5
DRAFT_MODEL=claude-sonnet-4-6
TRIAGE_MAX_TOKENS=200

# --- OpenAI (embeddings: cross-thread context + reply-tone memory) ---
# Optional — missing key just disables embeddings/tone-matching (logged, no crash).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MIN_SIMILARITY=0.78
EMBEDDING_TOP_K=3

# --- Microsoft Graph (Mail.Read only — this app never sends/moves/deletes mail) ---
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
# Any random string >=32 chars; validated against inbound webhook payloads.
GRAPH_WEBHOOK_CLIENT_STATE=
# Public HTTPS endpoints for Graph change notifications. Leave blank to rely
# solely on the poll-fallback worker (POLL_INTERVAL_SECONDS below).
GRAPH_NOTIFICATION_URL=
GRAPH_LIFECYCLE_URL=
# Comma-separated mailbox addresses this app is allowed to touch.
TARGET_MAILBOXES=
STALENESS_THRESHOLD_HOURS=24
POLL_INTERVAL_SECONDS=300
POLL_CONCURRENCY=3
SUBSCRIPTION_RENEW_INTERVAL_HOURS=48
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MSAL_CACHE_ENCRYPTION_KEY=

# --- Slack (draft review notifications) ---
# Set SLACK_ENABLED=false to skip review cards without clearing credentials.
SLACK_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_REVIEW_CHANNEL_ID=

# --- Database ---
# In docker-compose.prod.yml this file is the ONLY source of DATABASE_URL —
# use the `postgres` Compose service name as host, with the POSTGRES_PASSWORD
# you set in the repo-root .env, e.g.:
#   postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@postgres:5432/inbox_triage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inbox_triage
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis ---
# Outside local: must be rediss:// (TLS) with a password. In
# docker-compose.prod.yml this file is the ONLY source of REDIS_URL — use the
# `redis` Compose service name as host, with the REDIS_PASSWORD you set in
# the repo-root .env (see deploy/gen-redis-tls.sh), e.g.:
#   rediss://:<REDIS_PASSWORD>@redis:6379/0?ssl_cert_reqs=none
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Web auth (JWT access + rotating refresh cookie) ---
# Generate with: openssl rand -hex 32   (must be >=64 chars outside local)
JWT_SECRET=
JWT_ISSUER=inbox-triage-automation
JWT_AUDIENCE=inbox-triage-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=itr_refresh
CSRF_COOKIE_NAME=itr_csrf
CSRF_HEADER_NAME=X-CSRF-Token
REFRESH_ROTATION_GRACE_SECONDS=10

# --- Cookies / CORS ---
# Must be https:// outside local.
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
# Must be true outside local.
COOKIE_SECURE=false
API_HOST=localhost

# --- Reverse proxy ---
# Set true ONLY when a reverse proxy (nginx) in front of this app overwrites
# X-Forwarded-For — e.g. the deploy/nginx.conf.template setup. If a proxy sits
# in front and this stays false, rate limiting keys on the proxy's IP for
# every client instead of per-user.
TRUST_X_FORWARDED_FOR=false

# --- Rate limits ---
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_REFRESH_RATE_LIMIT=30/minute
API_DEFAULT_RATE_LIMIT=120/minute

# --- Webhooks ---
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# --- Dev-only routes (/simulate, /debug) ---
# Must be false outside local.
ENABLE_DEV_ROUTES=false
DEV_API_KEY=
