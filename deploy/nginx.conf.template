# Reverse proxy for inbox-triage-automation on a single EC2 instance.
# Replace __HOST__ with your sslip.io hostname (e.g. 3-91-x-x.sslip.io),
# copy to /etc/nginx/sites-available/inbox-triage, symlink into
# sites-enabled, then run certbot --nginx -d __HOST__.
#
# Client IP headers (rate limiting):
# - X-Real-IP is overwritten with $remote_addr (not spoofable by clients).
# - X-Forwarded-For is also set to $remote_addr (replace, do not append) so
#   leftover client-supplied prefixes cannot bypass app rate limits.
#   See https://nginx.org/en/docs/http/ngx_http_proxy_module.html#proxy_set_header

server {
    listen 80;
    server_name __HOST__;

    location /auth/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /webhooks/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
