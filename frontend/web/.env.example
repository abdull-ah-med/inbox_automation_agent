# Leave empty for same-origin API calls (recommended for local + production
# behind nginx). Next.js rewrites /auth and /api to BACKEND_PROXY_URL in
# development so CSRF cookies are readable on the SPA origin.
NEXT_PUBLIC_API_BASE_URL=

# Dev-only: FastAPI origin used by next.config.ts rewrites (not sent to browser).
BACKEND_PROXY_URL=http://localhost:8000
